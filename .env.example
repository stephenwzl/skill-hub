# LLM Configuration (OpenAI-compatible API)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini

# HTTP deployment should keep this false so browsers send login cookies.
COOKIE_SECURE=false

# System admin bootstrap (created on first launch)
# ADMIN_EMAIL=admin@skillhub.local
# ADMIN_PASSWORD=change-me-on-first-login

# Registration: allowed email domain (leave empty to allow any email)
# ALLOWED_EMAIL_DOMAIN=example.com

# SaaS / Self-hosted mode
# Set to "true" to unlock all features without subscription checks
SELF_HOSTED=true

# sqlite-vec extension path (optional, auto-detected if omitted)
# SQLITE_VEC_PATH=

# Skills directory (filesystem storage for SKILL.md + scripts/references/assets)
# Default: data/skills
# SKILL_HUB_SKILLS_DIR=data/skills
